rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to leaderboard and activity data
    match /pledges/{pledge} {
      allow read: if true;
      allow write: if true; // In production, this should be restricted to authenticated admins
    }
    
    match /donations/{donation} {
      allow read: if true;
      allow write: if true; // In production, this should be handled via cloud functions or restricted
    }
    
    match /activities/{activity} {
      allow read: if true;
      allow write: if true;
    }
    
    match /stats/{stat} {
      allow read: if true;
      allow write: if true;
    }

    // Debit order mandates — contain banking + personal/ID details.
    // Document ID == the supporter's Firebase Auth UID.
    // Only the owning supporter or a whitelisted admin may read/write.
    match /debitOrders/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if request.auth != null &&
        request.auth.token.email in ['ockertfernandes@gmail.com', 'admin@wrsa.org'];
    }
  }
}
